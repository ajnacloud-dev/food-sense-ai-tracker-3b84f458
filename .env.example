# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# Ibex Database API (external service - same for local and production)
IBEX_API_URL=https://smartlink.ajna.cloud/ibexdb
IBEX_API_KEY=your-ibex-api-key

# OpenAI API (for AI analysis features)
OPENAI_API_KEY=sk-proj-your-openai-api-key

# AWS Configuration (for production deployment only)
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=your-aws-account-id

# S3 Configuration
# Managed by Ibex DB Lambda. No direct S3 keys required.
